{
 "about": "Filo's fashion ontology and knowledge graph: a graph of concepts, synonyms and local phrases. A phrase points to a concept ID, never stands alone as a string. From FILO Product Intelligence Specification V2, sections 02 to 04 and 09, plus Brooklyn's intelligence engine notes (20 Oct 2026). The phrases are seed hypotheses to test, not measured search volume. Brooklyn edits this in Filo Studio; replace assumptions with Filo's own anonymized query data after launch.",
 "rule": "Map everyday phrases to concepts, but never treat concepts as the same when they need different evidence. Natural fibre is not automatically durable. Heavyweight is not automatically opaque. Made in Italy is not proof of fair labour or quality.",
 "launch_languages": [
  "en"
 ],
 "later_languages": [
  "fr",
  "es",
  "it",
  "de",
  "pt",
  "nl",
  "sv",
  "ja",
  "ko"
 ],
 "language_rules": [
  "Store the original text, detected language, normalized concepts, local synonyms and confidence.",
  "Reply in the shopper's language.",
  "Use locale-aware currency, sizing and spelling. Never translate size labels blindly; map the size system and show the brand's actual chart.",
  "Keep culturally specific garment names and brand spellings. Handle typos and transliteration, but never auto-correct one brand into a different brand."
 ],
 "intents": [
  {
   "id": "find_garment",
   "example": "Find me a boxy white tee.",
   "extracts": "category, silhouette, colour"
  },
  {
   "id": "fit_problem",
   "example": "Jeans that fit my waist and hips.",
   "extracts": "fit challenge, measurements or preferences only if volunteered, stretch and cut"
  },
  {
   "id": "material_performance",
   "example": "A warm wool coat that doesn't itch.",
   "extracts": "fibre, function, feel, weather or use"
  },
  {
   "id": "aesthetic_discovery",
   "example": "Something like Khaite but less expensive.",
   "extracts": "reference brand or aesthetic, price ceiling or relative budget, design cues"
  },
  {
   "id": "quality_validation",
   "example": "Is this sweater actually good quality?",
   "extracts": "product or brand identity, composition, construction, evidence needs"
  },
  {
   "id": "value_comparison",
   "example": "Best quality jeans under $150.",
   "extracts": "category, hard budget, quality threshold, value ranking"
  },
  {
   "id": "ethics_sourcing",
   "example": "Leather from a brand transparent about its supply chain.",
   "extracts": "material acceptance, traceability threshold, worker and animal-welfare constraints"
  },
  {
   "id": "occasion_wardrobe",
   "example": "A jacket for office and weekends.",
   "extracts": "occasion, versatility, season, formality"
  },
  {
   "id": "secondhand",
   "example": "Find vintage suede jackets in good condition.",
   "extracts": "resale allowed, vintage, material, condition, budget, region"
  },
  {
   "id": "image_reference",
   "example": "Find something with this shape.",
   "extracts": "visible attributes from the image only; never assume what can't be seen"
  }
 ],
